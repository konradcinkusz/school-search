# secrets.env.example: every variable school-search reads, by tier.
#
# Copy to .env (gitignored) with scripts/setup.sh or scripts/setup.ps1. Leave a
# value empty to skip it. Nothing here is required for the zero-credential run
# (principle P8 of architecture-standards): with every value empty the system
# starts and reports what is degraded at GET /health.
#
# Tiers:
#   always  - read on every run
#   mode    - selects a behaviour; a default applies when empty
#   secret  - a credential; never commit a value, never log it
#   ci      - set only in GitHub Actions environments, never locally
#   tuning  - optional operational knobs
#
# Each variable has a "degrades:" line: what the system does without it.
# The full description, including where each value comes from, is in
# scripts/README.md.

# --- always -----------------------------------------------------------------
# tier: always
# degrades: unset means Production behaviour; Development enables the AppHost banner and detailed errors.
ASPNETCORE_ENVIRONMENT=Development

# --- mode -------------------------------------------------------------------
# tier: mode
# degrades: unset or empty selects the InMemory provider; no data survives an API restart.
# values: postgres | sqlserver
DATABASE_PROVIDER=

# tier: mode
# degrades: unset means the web app tries CATALOG_API_URL, then services__api__http__0, then http://localhost:8080.
CATALOG_API_URL=

# --- secret -----------------------------------------------------------------
# tier: secret
# degrades: unset means the Postgres connection is not configured; with DATABASE_PROVIDER=postgres the API falls back to InMemory and /health says so.
# Format: Host=localhost;Port=5432;Database=catalogdb;Username=...;Password=replace-me
ConnectionStrings__catalogdb=

# tier: secret
# degrades: unset means admin endpoints (Phase C and later) answer 401 and are not mounted in Phase A.
ADMIN_API_KEY=

# tier: secret
# degrades: unset means MCP_API_KEY is absent: the MCP server serves the anonymous rate-limit bucket only (Phase D).
MCP_API_KEY=

# tier: secret
# degrades: unset means AI-assisted features are disabled and /health lists the ai integration as disabled. Nothing else changes.
ANTHROPIC_API_KEY=

# --- ci -----------------------------------------------------------------------
# tier: ci
# degrades: not read locally. Without it in the GitHub environment the first flyctl call in flyio.yml fails, which is the intended failure point.
FLY_API_TOKEN=

# --- tuning -------------------------------------------------------------------
# tier: tuning
# degrades: unset means no OTLP export; traces, metrics and logs stay in the process console.
OTEL_EXPORTER_OTLP_ENDPOINT=
