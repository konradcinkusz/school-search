# secrets.env.example: every variable school-search reads, by tier.
#
# Copy to .env (gitignored) with scripts/setup.sh or scripts/setup.ps1. Leave a
# value empty to skip it. Nothing here is required for the zero-credential run
# (principle P8 of architecture-standards): with every value empty the system
# starts and reports what is degraded at GET /health.
#
# Tiers:
#   always  - read on every run
#   mode    - selects a behaviour; a default applies when empty
#   secret  - a credential; never commit a value, never log it
#   ci      - set only in GitHub Actions environments, never locally
#   tuning  - optional operational knobs
#
# Each variable has a "degrades:" line: what the system does without it.
# The full description, including where each value comes from, is in
# scripts/README.md.

# --- always -----------------------------------------------------------------
# tier: always
# degrades: unset means Production behaviour; Development enables the AppHost banner and detailed errors.
ASPNETCORE_ENVIRONMENT=Development

# --- mode -------------------------------------------------------------------
# tier: mode
# degrades: unset or empty selects the InMemory provider; no data survives an API restart.
# values: postgres | sqlserver
DATABASE_PROVIDER=

# tier: mode
# degrades: unset means the web app tries CATALOG_API_URL, then services__api__http__0, then http://localhost:8080.
CATALOG_API_URL=

# --- secret -----------------------------------------------------------------
# tier: secret
# degrades: unset means the Postgres connection is not configured; with DATABASE_PROVIDER=postgres the API falls back to InMemory and /health says so.
# Format: Host=localhost;Port=5432;Database=catalogdb;Username=...;Password=replace-me
ConnectionStrings__catalogdb=

# tier: secret
# degrades: unset means MCP_API_KEY is absent: the MCP server serves the anonymous rate-limit bucket only (Phase D).
MCP_API_KEY=

# tier: secret
# degrades: unset means AI-assisted features are disabled and /health lists the ai integration as disabled. Nothing else changes.
# The Billing service's profile-copy assistant (Phase F) reads the same key and answers 503 ai_unavailable without it.
# Phase G: the Api, Reviews, Billing and MCP (the agent "Doradca", ADR-0017) read it; the key is one value, never shared by file.
ANTHROPIC_API_KEY=

# tier: secret
# degrades: unset means the Reviews service selects InMemory in Development/Staging, and answers 503 in Production. Never commit a value.
# Format: Host=localhost;Port=5432;Database=reviewsdb;Username=...;Password=replace-me
ConnectionStrings__reviewsdb=

# tier: secret
# degrades: unset means review writes answer 503 in Production (reads still work); outside Production a per-process pepper is generated (local only; with SeedDemo the AppHost keeps one in .local/seed-secrets.json). Keys every stored author hash: never change it once reviews exist.
# Format: hex or base64 of at least 32 random bytes (openssl rand -hex 32).
Reviews__SubjectPepper=

# tier: secret
# degrades: unset means the web BFF cannot seal its session cookie: account routes answer 503 and pages show "Konta są chwilowo niedostępne".
# Format: at least 32 bytes (openssl rand -base64 48). Used by web/app only.
SESSION_SECRET=

# tier: secret
# degrades: unset means the BFF sends no shared secret; the API and the Reviews service keep the anonymous rate bucket for forwarded clients.
# Format: openssl rand -base64 32. Same value in the web app and in the API and Reviews services.
BFF_SHARED_SECRET=

# --- mode (accounts and reviews, Phase E) -----------------------------------
# tier: mode
# degrades: unset means the admin group of the API answers 404 (P8). Public issuer of authservice, the only identity provider.
Auth__Authority=

# tier: mode
# degrades: unset means the auth-gated endpoints answer 503 auth_unavailable. With Auth__Authority set, a missing issuer stops startup (ADR-0015).
# Must equal authservice's Jwt__Issuer (flyio/authservice.fly.toml).
Auth__Issuer=

# tier: mode
# degrades: unset means the auth-gated endpoints answer 503 auth_unavailable. With Auth__Authority set, a missing audience stops startup (ADR-0015).
# Must equal authservice's Jwt__Audience. Never the default "AuthService".
Auth__Audience=

# tier: mode
# degrades: unset means the BFF answers its account routes with 503 and the pages show the unavailable state (P8).
AUTH_BASE_URL=

# tier: mode
# degrades: unset means the review section on school pages and the /zglos-tresc form show the unavailable state; catalog pages are unaffected.
REVIEWS_BASE_URL=

# tier: mode
# degrades: unset means the contact point answers 503 contact_not_configured (DSA art. 11/12). No address is invented.
Dsa__ContactEmail=

# tier: mode
# degrades: unset or false means the review triage worker is idle and the moderator queue shows no AI label (P8). Also the kill
# switch for the explain, search-intent and methodology answers in the Api, the profile assistant in Billing and the agent in MCP.
# Production keeps it false in flyio/*.fly.toml until the eval gate passes (docs/runbooks/AI-OPERATIONS.md).
AI_ENABLED=

# tier: mode
# degrades: unset means the code default (200000 tokens per UTC day in the Api, 100000 in Reviews, Billing and MCP). Cost guard, in memory per process.
AI_DAILY_TOKEN_BUDGET=

# --- mode (monetisation, Phase F) -------------------------------------------
# tier: mode
# degrades: unset means true outside Production (synthetic checkout and the simulate endpoint are on, local only) and false in Production (checkout answers 503 billing_unavailable, simulate 403). Never set true in Production.
Billing__MockMode=

# tier: mode
# degrades: unset means the billing service answers checkout with 503 billing_unavailable in Production; in mock mode the synthetic checkout URL is used. Public origin of the provider's checkout, set only with a provider adapter (ADR-0016).
Billing__CheckoutBaseUrl=

# tier: mode
# degrades: unset means the billing features on the web app show the unavailable state ("niedostępne"); catalog and reviews pages are unaffected (P8).
BILLING_BASE_URL=

# tier: mode
# degrades: unset means the /doradca page and its BFF route answer the unavailable state (P8); the rest of the web app is unaffected. Public origin of the MCP service (ADR-0017).
AGENT_BASE_URL=

# --- secret (monetisation, Phase F) -----------------------------------------
# tier: secret
# degrades: unset means the billing service selects InMemory outside Production and answers 503 in Production. Holds billingdb only.
# Format: Host=localhost;Port=5432;Database=billingdb;Username=...;Password=replace-me
ConnectionStrings__billingdb=

# tier: secret
# degrades: unset means the billing service generates a per-process pepper outside Production (local data only; with SeedDemo the AppHost keeps one in .local/seed-secrets.json) and refuses writes in Production. Keys the subject hash of claims and subscriptions: never change it once they exist. Unrelated to Reviews__SubjectPepper.
# Format: hex or base64 of at least 32 random bytes (openssl rand -hex 32).
Billing__SubjectPepper=

# tier: secret
# degrades: unset means mock mode accepts unsigned webhooks outside Production, and Production rejects every webhook with 401 (never accept unsigned requests in production). Value from the payment provider's dashboard once a provider is chosen (ADR-0016).
Billing__WebhookSecret=

# --- ci -----------------------------------------------------------------------
# tier: ci
# degrades: not read locally. Without it in the GitHub environment the first flyctl call in flyio.yml fails, which is the intended failure point.
FLY_API_TOKEN=

# tier: ci
# degrades: not read locally. Without it in the GitHub environment the authservice deploy job fails before any change, which is the intended failure point.
# Single line with literal \n escapes for newlines. Generated once; never printed, never committed. See docs/runbooks/AUTHSERVICE.md.
AUTHSERVICE_JWT_PRIVATE_KEY_PEM=

# tier: ci
# degrades: not read locally. Repository variable (not a secret) holding the pinned authservice image, for example ghcr.io/konradcinkusz/authservice:v0.3.4.
AUTHSERVICE_IMAGE=

# tier: ci
# degrades: not read locally. Without it in the GitHub environment the billing deploy job fails before any change, which is the intended failure point. Generated once with openssl rand -hex 32; different from the reviews pepper.
BILLING_SUBJECT_PEPPER=

# tier: ci
# degrades: not read locally. Without it in the GitHub environment the billing deploy still runs, and every webhook is rejected in Production until it is set. Provider's signing secret, from its dashboard (ADR-0016).
BILLING_WEBHOOK_SECRET=

# --- local seeding (Phase L, ADR-0019) -------------------------------------
# Read by the AppHost from dotnet user-secrets or the environment (src/SchoolSearch.AppHost), never from this file.
# Values the AppHost generates are kept in .local/seed-secrets.json (gitignored, mode 0600 on Unix), so they stay the same
# across runs. Reset: delete that file and the Docker volume school-search-postgres-data together.
# Local only. The seeder and the dev seed endpoints never run in Production.

# tier: mode
# degrades: unset means true: the AppHost seeds the demo catalog, starts authservice and the seeder. false starts with an empty catalog, no seeder, no dev seed endpoints (404).
SeedDemo=

# tier: mode
# degrades: unset means it follows SeedDemo: authservice runs as a container. Without authservice there are no accounts and the sign-in pages show the unavailable state.
IncludeAuthservice=

# tier: mode
# degrades: unset means admin@school-search.test. Email of the SuperAdmin account created through authservice's initial-admin setting.
Seed__AdminEmail=

# tier: secret
# degrades: unset means the AppHost uses the test password in .local/seed-secrets.json, generating it on the first run. The seeder prints it in its log on each run. Set, it is used and not printed. Password of the test accounts (docs/runbooks/LOCAL-DEV.md). Never commit a value.
Seed__TestPassword=

# tier: secret
# degrades: unset means the AppHost uses the RS256 key in .local/seed-secrets.json, generating it on the first run (tokens survive restarts). Set, it is used as the authservice signing key. Local dev key only, one line with literal \n; never the production key (docs/runbooks/AUTHSERVICE.md section 5).
Authservice__JwtPrivateKeyPem=

# tier: mode
# degrades: set by the AppHost when SeedDemo is on, never set by hand. Enables the /dev/seed endpoints of Reviews and Billing; off means they answer 404.
DevSeed__Enabled=

# tier: secret
# degrades: set by the AppHost, never set by hand: a random 32-byte value, generated once and kept in .local/seed-secrets.json. Without the matching X-Dev-Seed-Key header the /dev/seed endpoints answer 404.
DevSeed__Key=

# --- tuning -------------------------------------------------------------------
# tier: tuning
# degrades: unset means no OTLP export; traces, metrics and logs stay in the process console.
OTEL_EXPORTER_OTLP_ENDPOINT=
