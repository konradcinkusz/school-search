<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SchoolSearch.Architecture.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SchoolSearch.Api\SchoolSearch.Api.csproj" />
    <ProjectReference Include="..\..\src\SchoolSearch.Catalog.Data\SchoolSearch.Catalog.Data.csproj" />
    <ProjectReference Include="..\..\src\SchoolSearch.ServiceDefaults\SchoolSearch.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\SchoolSearch.Contracts\SchoolSearch.Contracts.csproj" />
    <ProjectReference Include="..\..\src\SchoolSearch.Import\SchoolSearch.Import.csproj" />
  </ItemGroup>

  <!-- ADR-0015: the Reviews service is a separate deployable. Referenced only once its project exists, so the solution builds before it lands. -->
  <ItemGroup Condition="Exists('..\..\src\SchoolSearch.Reviews\SchoolSearch.Reviews.csproj')">
    <ProjectReference Include="..\..\src\SchoolSearch.Reviews\SchoolSearch.Reviews.csproj" />
  </ItemGroup>

  <!-- ADR-0016 (Phase F): the Billing service is a separate deployable, referenced only once its project exists. Rules that name it are non-vacuous once it lands. -->
  <ItemGroup Condition="Exists('..\..\src\SchoolSearch.Billing\SchoolSearch.Billing.csproj')">
    <ProjectReference Include="..\..\src\SchoolSearch.Billing\SchoolSearch.Billing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
