<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SchoolSearch.Catalog.Data</RootNamespace>
    <AssemblyName>SchoolSearch.Catalog.Data</AssemblyName>
  </PropertyGroup>

  <!--
    Owns the catalog schema (P3: database per service). Provider selection and the
    SqlServer package are the kernel's job (AddDatabaseContext). Npgsql is referenced only for
    the PostgreSQL migrations (Migrations/Npgsql), which name NpgsqlValueGenerationStrategy for
    identity columns. The model itself stays provider-agnostic.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
